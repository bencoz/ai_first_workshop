###############################
# Example Environment Variables
# Copy to `.env` and replace placeholders. Do NOT commit your real `.env`.
###############################

# Flask secret key: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=replace_me_with_secure_random_hex

# Core Flask settings
FLASK_APP=apps/flask-todo/app.py
FLASK_ENV=development  # or 'production'
FLASK_DEBUG=1          # Set to 0 (or remove) in production

# Database URL for SQLAlchemy (leave default if using built-in sqlite file)
DATABASE_URL=sqlite:///instance/db.sqlite

# Optional feature toggles (future expansion)
# CSRF_ENABLED=1
# LOG_LEVEL=INFO

# Notes:
# - Keep this file minimal; document new variables here as they are introduced.
# - The application will fallback gracefully if some variables are not set.
